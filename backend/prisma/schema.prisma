generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  EDITOR
  REPORTER
  SEO
  ADVERTISEMENT
  PHOTOGRAPHER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(REPORTER)
  status       AccountStatus @default(ACTIVE)
  isFirstLogin Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  author       Author?

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // SHA-256 hash of the refresh token
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model Author {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  nameGu        String
  nameHi        String
  image         String   @db.Text
  designation   String
  designationGu String
  designationHi String
  bio           String   @db.Text
  bioGu         String   @db.Text
  bioHi         String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  posts         Post[]

  @@map("authors")
}

enum PostStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  SCHEDULED
}

model Category {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  nameGu        String
  nameHi        String
  description   String?  @db.Text
  descriptionGu String?  @db.Text
  descriptionHi String?  @db.Text
  icon          String?
  color         String?
  displayOrder  Int      @default(0)
  headerOrder   Int      @default(0)
  homeOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  showInHome    Boolean  @default(true)
  showInHeader  Boolean  @default(true)
  headerType    String   @default("GLOBAL")
  posts         Post[]
  videos        Video[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("categories")
}

model Post {
  id             String     @id @default(uuid())
  slug           String     @unique
  articleNumber  Int?       @unique
  language       String     @default("gu")
  title          String
  titleGu        String
  titleHi        String
  excerpt        String?    @db.Text
  excerptGu      String?    @db.Text
  excerptHi      String?    @db.Text
  content        String     @db.Text
  contentGu      String     @db.Text
  contentHi      String     @db.Text
  featuredImage  String     @db.Text
  status         PostStatus @default(DRAFT)
  scheduledAt    DateTime?
  authorId       String
  author         Author     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location       String?
  tags           PostTag[]
  readingTime    Int        @default(0)
  priority       Int        @default(0)
  isTrending     Boolean    @default(false)
  isBreaking     Boolean    @default(false)
  isFeatured     Boolean    @default(false)
  views          Int        @default(0)
  seoTitle       String?    @db.Text
  seoDescription String?    @db.Text
  seoKeywords    String?    @db.Text
  canonicalUrl   String?    @db.Text
  metaRobots     String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([isTrending, status, createdAt])
  @@index([isFeatured, status, createdAt])
  @@index([isBreaking, status, createdAt])
  @@map("posts")
}

model Tag {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  nameGu    String
  nameHi    String
  posts     PostTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("tags")
}

model PostTag {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@map("post_tags")
}

model Video {
  id           String    @id @default(uuid())
  title        String
  titleGu      String
  titleHi      String
  description  String?   @db.Text
  thumbnail    String    @db.Text
  youtubeId    String
  embedUrl     String    @db.Text
  duration     String    @default("0:00")
  type         String    @default("video") // video | short | podcast | interview
  categoryId   String?
  categoryName String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isFeatured   Boolean   @default(false)
  channel      String?   @default("Gujarat Post News")
  views        Int       @default(0)
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("videos")
}

model GalleryPhoto {
  id           String   @id @default(uuid())
  src          String   @db.Text
  alt          String
  caption      String   @db.Text
  captionGu    String   @db.Text
  captionHi    String   @db.Text
  category     String?  @default("સમાચાર")
  photographer String
  copyright    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("gallery_photos")
}

model InstagramStory {
  id        String                @id @default(uuid())
  name      String
  nameGu    String
  nameHi    String
  avatar    String                @db.Text
  hasUnseen Boolean               @default(true)
  slides    InstagramStorySlide[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@map("instagram_stories")
}

model InstagramStorySlide {
  id          String         @id @default(uuid())
  storyId     String
  story       InstagramStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  mediaType   String         @default("image") // image | video
  mediaUrl    String         @db.Text
  captionEn   String         @db.Text
  captionGu   String         @db.Text
  captionHi   String         @db.Text
  timestampGu String         @default("હમણાં જ")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("instagram_story_slides")
}

model WebStory {
  id        String   @id @default(uuid())
  heading   String
  headingGu String?
  headingHi String?
  image1    String   @db.Text
  image2    String?  @db.Text
  image3    String?  @db.Text
  image4    String?  @db.Text
  image5    String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("web_stories")
}

model BreakingTickerItem {
  id        String   @id @default(uuid())
  en        String   @db.Text
  gu        String   @db.Text
  hi        String   @db.Text
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("breaking_ticker_items")
}

model AstrologySign {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  nameGu       String
  nameHi       String
  image        String   @db.Text
  prediction   String   @db.Text
  predictionGu String   @db.Text
  detailsJson  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("astrology_signs")
}

model HeroSetting {
  id              String   @id @default("default")
  slot1Id         String?
  slot2Id         String?
  slot3Id         String?
  trendingTopics  String?  @db.Text
  trendingNewsIds String?  @db.Text
  popularNewsIds  String?  @db.Text
  mostReadIds     String?  @db.Text
  heroGridIds     String?  @db.Text
  updatedAt       DateTime @updatedAt

  @@map("hero_settings")
}

model Reel {
  id          String    @id @default(uuid())
  type        String    @default("INSTAGRAM") // "VIDEO" or "INSTAGRAM"
  heading     String    @db.Text
  headingGu   String    @db.Text
  headingHi   String    @db.Text
  videoUrl    String?   @db.Text // Used if type is "VIDEO"
  instaUrl    String?   @db.Text // Used if type is "INSTAGRAM"
  thumbnail   String?   @db.Text // Cover thumbnail image URL
  isActive    Boolean   @default(true)
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("reels")
}

model Advertisement {
  id              String   @id @default(uuid())
  section         String   @unique // e.g. "AFTER_HERO", "SIDEBAR_HERO_TOP", "SIDEBAR_GUJARAT", "SIDEBAR_WORLD", "SIDEBAR_POPULAR"
  title           String?  // Optional name label for admin reference
  isActive        Boolean  @default(true)
  includeInRandom Boolean  @default(false)
  mediaType       String   @default("IMAGE") // "IMAGE" or "VIDEO"
  image1          String?  @db.Text
  link1           String?  @db.Text
  image2          String?  @db.Text
  link2           String?  @db.Text
  image3          String?  @db.Text
  link3           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("advertisements")
}

model EPaperEdition {
  id           String   @id @default(uuid())
  title        String   @default("City Edition")
  city         String
  cityGu       String?
  cityHi       String?
  date         String
  pages        Int      @default(24)
  fileUrl      String   @db.Text
  thumbnailUrl String?  @db.Text
  status       String   @default("PUBLISHED")
  publishTime  String?  @default("06:00 AM")
  isActive     Boolean  @default(true)
  editionType  String   @default("PDF")
  templateData String?  @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([city, date, status])
  @@index([isActive, status, date])
  @@map("epaper_editions")
}

model EPaperCity {
  id        String   @id @default(uuid())
  city      String   @unique
  cityGu    String?
  cityHi    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("epaper_cities")
}

model SupportSetting {
  id            String   @id @default("default")
  qrCodeImage   String?  @db.Text
  upiId         String?
  accountName   String?  
  accountNumber String?
  ifscCode      String?
  bankName      String?
  branchName    String?
  noteGu        String?  @db.Text
  noteEn        String?  @db.Text
  noteHi        String?  @db.Text
  updatedAt     DateTime @updatedAt

  @@map("support_settings")
}

