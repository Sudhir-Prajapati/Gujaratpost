generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(REPORTER)
  status       AccountStatus @default(ACTIVE)
  isFirstLogin Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  author       Author?
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_userId_fkey")
  @@map("sessions")
}

model Author {
  id            String   @id @default(uuid())
  userId        String   @unique
  name          String
  nameGu        String
  nameHi        String
  image         String   @db.Text
  designation   String
  designationGu String
  designationHi String
  bio           String   @db.Text
  bioGu         String   @db.Text
  bioHi         String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts         Post[]

  @@map("authors")
}

model Category {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  nameGu        String
  nameHi        String
  description   String?  @db.Text
  descriptionGu String?  @db.Text
  descriptionHi String?  @db.Text
  icon          String?
  color         String?
  displayOrder  Int      @default(0)
  headerOrder   Int      @default(0)
  homeOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  showInHome    Boolean  @default(true)
  showInHeader  Boolean  @default(true)
  headerType    String   @default("GLOBAL")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  posts         Post[]
  videos        Video[]
  rssSources    RssSource[]
  rssItems      RssItem[]

  @@map("categories")
}

model Post {
  id             String     @id @default(uuid())
  slug           String     @unique
  articleNumber  Int?       @unique
  language       String     @default("gu")
  title          String
  titleGu        String
  titleHi        String
  excerpt        String?    @db.Text
  excerptGu      String?    @db.Text
  excerptHi      String?    @db.Text
  content        String     @db.Text
  contentGu      String     @db.Text
  contentHi      String     @db.Text
  featuredImage  String     @db.Text
  status         PostStatus @default(DRAFT)
  scheduledAt    DateTime?
  authorId       String
  categoryId     String
  location       String?
  readingTime    Int        @default(0)
  priority       Int        @default(0)
  isTrending     Boolean    @default(false)
  isBreaking     Boolean    @default(false)
  isFeatured     Boolean    @default(false)
  views          Int        @default(0)
  seoTitle       String?    @db.Text
  seoDescription String?    @db.Text
  seoKeywords    String?    @db.Text
  canonicalUrl   String?    @db.Text
  metaRobots     String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  tags           PostTag[]
  author         Author     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category       Category   @relation(fields: [categoryId], references: [id])

  @@index([status, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([isTrending, status, createdAt])
  @@index([isFeatured, status, createdAt])
  @@index([isBreaking, status, createdAt])
  @@index([status, views, createdAt])
  @@index([status, articleNumber])
  @@index([categoryId, status, articleNumber])
  @@index([status, isFeatured, articleNumber])
  @@index([categoryId, status, isFeatured, articleNumber])
  @@index([authorId], map: "posts_authorId_fkey")
  @@map("posts")
}

model Tag {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  nameGu    String
  nameHi    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  posts     PostTag[]

  @@map("tags")
}

model PostTag {
  id     String @id @default(uuid())
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([tagId], map: "post_tags_tagId_fkey")
  @@map("post_tags")
}

model Video {
  id           String    @id @default(uuid())
  title        String
  titleGu      String
  titleHi      String
  description  String?   @db.Text
  thumbnail    String    @db.Text
  youtubeId    String
  embedUrl     String    @db.Text
  duration     String    @default("0:00")
  type         String    @default("video")
  categoryId   String?
  categoryName String?
  isFeatured   Boolean   @default(false)
  channel      String?   @default("Gujarat Post News")
  views        Int       @default(0)
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  category     Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId], map: "videos_categoryId_fkey")
  @@map("videos")
}

model GalleryPhoto {
  id           String   @id @default(uuid())
  src          String   @db.Text
  alt          String
  caption      String   @db.Text
  captionGu    String   @db.Text
  captionHi    String   @db.Text
  category     String?  @default("સમાચાર")
  photographer String
  copyright    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("gallery_photos")
}

model InstagramStory {
  id        String                @id @default(uuid())
  name      String
  nameGu    String
  nameHi    String
  avatar    String                @db.Text
  hasUnseen Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  slides    InstagramStorySlide[]

  @@map("instagram_stories")
}

model InstagramStorySlide {
  id          String         @id @default(uuid())
  storyId     String
  mediaType   String         @default("image")
  mediaUrl    String         @db.Text
  captionEn   String         @db.Text
  captionGu   String         @db.Text
  captionHi   String         @db.Text
  timestampGu String         @default("હમણાં જ")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  story       InstagramStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId], map: "instagram_story_slides_storyId_fkey")
  @@map("instagram_story_slides")
}

model WebStory {
  id        String   @id @default(uuid())
  heading   String
  headingGu String?
  headingHi String?
  image1    String   @db.Text
  image2    String?  @db.Text
  image3    String?  @db.Text
  image4    String?  @db.Text
  image5    String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("web_stories")
}

model BreakingTickerItem {
  id        String   @id @default(uuid())
  en        String   @db.Text
  gu        String   @db.Text
  hi        String   @db.Text
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("breaking_ticker_items")
}

model AstrologySign {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  nameGu       String
  nameHi       String
  image        String   @db.Text
  prediction   String   @db.Text
  predictionGu String   @db.Text
  detailsJson  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("astrology_signs")
}

model HeroSetting {
  id              String   @id @default("default")
  slot1Id         String?
  slot2Id         String?
  slot3Id         String?
  tickerLabel     String?  @db.Text
  trendingTopics  String?  @db.Text
  trendingNewsIds String?  @db.Text
  popularNewsIds  String?  @db.Text
  mostReadIds     String?  @db.Text
  heroGridIds     String?  @db.Text
  heroGridMode    String?  @default("auto") @db.VarChar(50)
  heroSliderMode  String?  @default("auto") @db.VarChar(50)
  heroSliderIds   String?  @db.Text
  mostReadMode    String?  @default("auto") @db.VarChar(50)
  updatedAt       DateTime @updatedAt

  @@map("hero_settings")
}

model Reel {
  id          String    @id @default(uuid())
  type        String    @default("INSTAGRAM")
  heading     String    @db.Text
  headingGu   String    @db.Text
  headingHi   String    @db.Text
  videoUrl    String?   @db.Text
  instaUrl    String?   @db.Text
  thumbnail   String?   @db.Text
  isActive    Boolean   @default(true)
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("reels")
}

model Advertisement {
  id              String   @id @default(uuid())
  section         String   @unique
  title           String?
  isActive        Boolean  @default(true)
  includeInRandom Boolean  @default(false)
  mediaType       String   @default("IMAGE")
  image1          String?  @db.Text
  link1           String?  @db.Text
  image2          String?  @db.Text
  link2           String?  @db.Text
  image3          String?  @db.Text
  link3           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("advertisements")
}

model EPaperEdition {
  id           String   @id @default(uuid())
  title        String   @default("City Edition")
  city         String
  cityGu       String?
  cityHi       String?
  date         String
  pages        Int      @default(24)
  fileUrl      String   @db.Text
  thumbnailUrl String?  @db.Text
  status       String   @default("PUBLISHED")
  publishTime  String?  @default("06:00 AM")
  isActive     Boolean  @default(true)
  editionType  String   @default("PDF")
  templateData String?  @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([city, date, status])
  @@index([isActive, status, date])
  @@map("epaper_editions")
}

model EPaperCity {
  id        String   @id @default(uuid())
  city      String   @unique
  cityGu    String?
  cityHi    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("epaper_cities")
}

model SupportSetting {
  id            String   @id @default("default")
  supportEnabled Boolean  @default(true)
  qrCodeImage   String?  @db.Text
  upiId         String?
  accountName   String?
  accountNumber String?
  ifscCode      String?
  bankName      String?
  branchName    String?
  noteGu        String?  @db.Text
  noteEn        String?  @db.Text
  noteHi        String?  @db.Text
  updatedAt     DateTime @updatedAt

  @@map("support_settings")
}

model AboutSetting {
  id              String   @id @default("default")
  titleGu         String?  @db.Text
  titleEn         String?  @db.Text
  titleHi         String?  @db.Text
  subtitleGu      String?  @db.Text
  subtitleEn      String?  @db.Text
  subtitleHi      String?  @db.Text
  descriptionGu   String?  @db.LongText
  descriptionEn   String?  @db.LongText
  descriptionHi   String?  @db.LongText
  bannerImage     String?  @db.Text
  missionGu       String?  @db.Text
  missionEn       String?  @db.Text
  missionHi       String?  @db.Text
  visionGu        String?  @db.Text
  visionEn        String?  @db.Text
  visionHi        String?  @db.Text
  rulesTitle      String?  @default("અમારા અડગ નિયમો") @db.VarChar(255)
  rulesJson       String?  @db.LongText
  valuesJson      String?  @db.LongText
  statsJson       String?  @db.LongText
  teamJson        String?  @db.LongText
  contactEmail    String?
  contactPhone    String?
  contactAddress  String?  @db.Text
  whatsappNumber  String?
  updatedAt       DateTime @updatedAt

  @@map("about_settings")
}

model ContactSetting {
  id                  String   @id @default("default")
  pageTitle           String?  @default("સંપર્ક કરો (Contact Us)") @db.VarChar(255)
  pageSubtitle        String?  @db.Text
  headOfficeAddress   String?  @db.Text
  primaryPhone        String?  @default("+91 99099 07237")
  whatsappNumber      String?  @default("+91 99099 07237")
  primaryEmail        String?  @default("contact@gujaratpost.in")
  workingHours        String?  @default("સોમવાર - શનિવાર: 9:00 AM - 9:00 PM | રવિવાર: 24x7 ન્યૂઝ ડેસ્ક") @db.VarChar(255)
  mapEmbedUrl         String?  @db.Text
  editorialEmail      String?  @default("editorial@gujaratpost.in")
  editorialPhone      String?  @default("+91 99099 07237")
  adsEmail            String?  @default("ads@gujaratpost.in")
  adsPhone            String?  @default("+91 99099 07237")
  grievanceName       String?  @default("મહેશ પટેલ (Mahesh Patel)")
  grievanceDesignation String? @default("તકરાર નિવારણ અધિકારી (Grievance Redressal Officer)")
  grievanceEmail      String?  @default("grievance@gujaratpost.in")
  grievanceAddress    String?  @db.Text
  bureauOfficesJson   String?  @db.LongText
  socialLinksJson     String?  @db.Text
  updatedAt           DateTime @updatedAt

  @@map("contact_settings")
}

model AdvertiseSetting {
  id              String   @id @default("default")
  pageTitle       String?  @default("Advertise With Us") @db.VarChar(255)
  description     String?  @db.LongText
  officeAddress   String?  @db.Text
  locationUrl     String?  @db.Text
  contactPhone    String?  @default("079 4000 4000 / +91 99099 07237")
  onlineAdsEmail  String?  @default("digital.advertising@gujaratpost.in")
  printAdsEmail   String?  @default("advt@gujaratpost.in & epaper@gujaratpost.in")
  websiteUrl      String?  @default("https://gujaratpost.in/") @db.VarChar(255)
  socialLinksJson String?  @db.LongText
  appLinksJson    String?  @db.LongText
  badgeText       String?  @default("Partner With Gujarat Post") @db.VarChar(255)
  pageSubtitle    String?  @db.Text
  contactEmail    String?  @default("ads@gujaratpost.in")
  whatsappNumber  String?  @default("+91 99099 07237")
  workingHours    String?  @default("Monday - Saturday: 9:00 AM - 8:00 PM") @db.VarChar(255)
  rateCardNote    String?  @db.Text
  rateCardPdfUrl  String?  @db.Text
  statsJson       String?  @db.LongText
  adOptionsJson   String?  @db.LongText
  benefitsJson    String?  @db.LongText
  updatedAt       DateTime @updatedAt

  @@map("advertise_settings")
}

model ContactMessage {
  id         String   @id @default(uuid())
  name       String
  email      String
  phone      String?
  department String?  @default("General")
  subject    String   @db.VarChar(255)
  message    String   @db.LongText
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("contact_messages")
}

model FeedbackComplaint {
  id         String   @id @default(uuid())
  type       String   @default("FEEDBACK") @db.VarChar(50) // 'FEEDBACK' or 'COMPLAINT'
  name       String   @db.VarChar(191)
  email      String   @db.VarChar(191)
  phone      String?  @db.VarChar(100)
  category   String   @default("General") @db.VarChar(100)
  subject    String   @db.VarChar(255)
  message    String   @db.LongText
  articleUrl String?  @db.Text
  status     String   @default("PENDING") @db.VarChar(50) // 'PENDING', 'IN_REVIEW', 'RESOLVED'
  adminNotes String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([type, status], map: "idx_fc_type_status")
  @@index([createdAt], map: "idx_fc_created")
  @@map("feedback_complaints")
}


model LegalPage {
  id           String   @id
  pageTitle    String   @db.VarChar(255)
  lastUpdated  String?  @db.VarChar(191)
  introText    String?  @db.LongText
  sectionsJson String?  @db.LongText
  contentHtml  String?  @db.LongText
  updatedAt    DateTime @updatedAt

  @@map("legal_pages")
}

model Tribute {
  id         String   @id @default(uuid())
  type       String   @default("BIRTHDAY") @db.VarChar(50)
  name       String   @db.VarChar(255)
  photo      String?  @db.Text
  date       String?  @db.VarChar(100)
  info       String?  @db.Text
  templateId String   @default("golden") @db.VarChar(50)
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  startDate  String?  @db.VarChar(50)
  endDate    String?  @db.VarChar(50)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([type, isActive])
  @@map("tributes")
}


enum Role {
  SUPER_ADMIN
  EDITOR
  REPORTER
  SEO
  ADVERTISEMENT
  PHOTOGRAPHER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum PostStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  SCHEDULED
}

enum RssItemStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

model RssSource {
  id              String         @id @default(uuid())
  name            String
  url             String         @db.Text
  categoryId      String?
  isActive        Boolean        @default(true)
  pollingInterval Int            @default(60)
  lastFetchedAt   DateTime?
  lastSuccessAt   DateTime?
  lastError       String?        @db.Text
  etag            String?
  lastModified    String?
  itemCount       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items           RssItem[]
  logs            RssFetchLog[]

  @@index([categoryId], map: "rss_sources_categoryId_fkey")
  @@map("rss_sources")
}

model RssItem {
  id               String        @id @default(uuid())
  sourceId         String
  guid             String        @db.VarChar(500)
  sourceUrl        String        @db.Text
  title            String        @db.Text
  titleGu          String?       @db.Text
  excerpt          String?       @db.Text
  content          String?       @db.LongText
  author           String?
  imageUrl         String?       @db.Text
  categoryName     String?
  targetCategoryId String?
  pubDate          DateTime?
  status           RssItemStatus @default(PENDING)
  publishedPostId  String?
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  source           RssSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  targetCategory   Category?     @relation(fields: [targetCategoryId], references: [id], onDelete: SetNull)

  @@unique([sourceId, guid(255)])
  @@index([status, createdAt])
  @@index([sourceId, status])
  @@index([targetCategoryId], map: "rss_items_targetCategoryId_fkey")
  @@map("rss_items")
}

model RssFetchLog {
  id            String    @id @default(uuid())
  sourceId      String
  status        String
  itemsFound    Int       @default(0)
  itemsImported Int       @default(0)
  errorMessage  String?   @db.Text
  durationMs    Int       @default(0)
  createdAt     DateTime  @default(now())

  source        RssSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, createdAt])
  @@map("rss_fetch_logs")
}

