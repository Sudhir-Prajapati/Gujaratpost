# Gujarat Post — Frontend Environment Configuration Example
# ============================================================

# ── JWT (Required for middleware token verification) ──────────
JWT_SECRET="replace_with_your_super_secret_jwt_signing_key_at_least_32_characters"

# ── API & Site URLs ──────────────────────────────────────────
# For Local Development:
# NEXT_PUBLIC_API_URL="http://127.0.0.1:5000/api/public"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# For Production (gujaratpost.in):
NEXT_PUBLIC_API_URL="https://api.gujaratpost.in/api/public"
NEXT_PUBLIC_APP_URL="https://gujaratpost.in"
NEXT_PUBLIC_SITE_URL="https://gujaratpost.in"

# ── Google Analytics 4 (GA4) ──────────────────────────────────
# Stream Name: Gujarat Post
# Stream ID: 7851258887
# Measurement ID: G-4K0RT88M7L
NEXT_PUBLIC_GA_ID="G-4K0RT88M7L"
